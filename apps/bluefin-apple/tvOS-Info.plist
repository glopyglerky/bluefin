<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BluefinPublicCatalogOrigin</key>
	<string>$(BLUEFIN_PUBLIC_CATALOG_ORIGIN)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Bluefin</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Bluefin</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Bluefin secure connection</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bluefin</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>Bluefin Top Shelf</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bluefin-shelf</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_bluefin-mesh._udp.</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Connect your iPhone using Apple's Continuity device picker. Bluefin does not capture camera video.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect to the media server you choose on your home network.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Use your selected iPhone microphone for local karaoke voice monitoring.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
